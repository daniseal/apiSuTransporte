{
  // Sección donde se guardan las cadenas de conexión del proyecto.
  // Aquí se define cómo el API se conecta a SQL Server.
  "ConnectionStrings": {

    // Nombre de la conexión que se usa en Program.cs.
    // Server=(localdb)\\MSSQLLocalDB: indica que se conecta a SQL Server LocalDB.
    // Database=bdSuTransporte: nombre de la base de datos.
    // Trusted_Connection=True: usa autenticación de Windows.
    // MultipleActiveResultSets=true: permite varias consultas activas al mismo tiempo.
    // TrustServerCertificate=True: acepta el certificado local de SQL Server.
    "ConexionSQL": "Server=(localdb)\\MSSQLLocalDB;Database=bdSuTransporte;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },

  // Configuración de los mensajes de registro del sistema.
  // Sirve para controlar qué tanta información muestra el API en consola.
  "Logging": {
    "LogLevel": {

      // Nivel general de información que se muestra.
      "Default": "Information",

      // Reduce los mensajes internos de ASP.NET Core para evitar exceso de información.
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Define qué hosts pueden acceder al API.
  // "*" significa que permite cualquier host.
  "AllowedHosts": "*"
}